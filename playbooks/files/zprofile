#
# Browser
#

if [[ "$OSTYPE" == darwin* ]]; then
  export BROWSER='open'
fi

#
# Editors
#

export EDITOR='vim'
export VISUAL='vim'
export PAGER='less'

#
# Language
#

if [[ -z "$LANG" ]]; then
  export LANG='en_US.UTF-8'
fi
# Paths
# -U removes duplicate entries; (N) drops any directory that doesn't exist.
typeset -gU cdpath fpath mailpath path
path=(
  $HOME/.poetry/bin(N)
  /usr/local/{bin,sbin}(N)
  $path
)

# Set the default Less options.
# Mouse-wheel scrolling has been disabled by -X (disable screen clearing).
# Remove -X and -F (exit if the content fits on one screen) to enable it.
export LESS='-F -g -i -M -R -S -w -X -z-4'

# Set the Less input preprocessor.
# Try both `lesspipe` and `lesspipe.sh` as either might exist on a system.
if (( $#commands[(i)lesspipe(|.sh)] )); then
  export LESSOPEN="| /usr/bin/env $commands[(i)lesspipe(|.sh)] %s 2>&-"
fi

export PATH="$HOME/.poetry/bin:$PATH"

# remap escape and caps lock behavior
## old way with setxkbmap using x11, doesn't work well with wayland. Set /etc/keyd/default.conf configuration with
# [ids]
# *
#
# [main]
# capslock = overload(control, esc)
# EOF

# Added by Toolbox App
export PATH="$PATH:/home/brian/.local/share/JetBrains/Toolbox/scripts"
